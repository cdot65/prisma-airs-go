  "info": {
    "description": "AgentGuard Management Plane API - Policy controls for skill scanning",
    "title": "AgentGuard Management Plane API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/instances": {
      "post": {
        "description": "Activate a tenant instance from its deployment profiles",
        "operationId": "create_instance_v1_instances_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InstanceCreateModelSchema"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceResponseModelSchema"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Instance",
        "tags": [
          "Instances"
        ]
      }
    },
    "/v1/instances/{tenant_id}": {
      "delete": {
        "description": "Deactivate all of a tenant's active deployment profiles",
        "operationId": "delete_instance_v1_instances__tenant_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "tenant_id",
            "required": true,
            "schema": {
              "title": "Tenant Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceResponseModelSchema"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Instance",
        "tags": [
          "Instances"
        ]
      },
      "get": {
        "description": "Get license/instance info for a tenant",
        "operationId": "get_instance_v1_instances__tenant_id__get",
        "parameters": [
          {
            "description": "Tenant ID",
            "in": "path",
            "name": "tenant_id",
            "required": true,
            "schema": {
              "description": "Tenant ID",
              "title": "Tenant Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceSchema"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Instance",
        "tags": [
          "Instances"
        ]
      },
      "put": {
        "description": "Update a tenant instance: reactivate, deactivate removed profiles, or refresh expirations",
        "operationId": "update_instance_v1_instances__tenant_id__put",
        "parameters": [
          {
            "in": "path",
            "name": "tenant_id",
            "required": true,
            "schema": {
              "title": "Tenant Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InstanceCreateModelSchema"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceResponseModelSchema"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Instance",
        "tags": [
          "Instances"
        ]
      }
    },
